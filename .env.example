# Copy to .env (compose reads it automatically) or to the file PANEL_ENV_FILE points at.

# Panel admin token (browser login). Generate a long random string.
ADMIN_TOKEN=change-me-to-a-long-random-string

# CPA remote-management plaintext secret. Server side only — never expose it.
CPA_MANAGEMENT_SECRET=replace-with-your-cpa-management-secret

# CPA base URL. From inside the container use host.docker.internal.
CPA_BASE_URL=http://host.docker.internal:5000

LISTEN=:5006
DATA_DIR=/data
SNAPSHOT_RETAIN=20

# Host-side placement, used by docker-compose.yml.
PANEL_PORT=5006
PANEL_ENV_FILE=./cpa-model-panel.env
PANEL_DATA_DIR=./data
